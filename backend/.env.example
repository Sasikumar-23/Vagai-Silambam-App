# Copy to .env and fill in. NEVER commit the real .env.

APP_ENV=development
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# PostgreSQL is the central SaaS database.
DATABASE_URL=postgresql+psycopg://vagai:change-me@localhost:5432/vagai_silambam

# openssl rand -hex 32
JWT_SECRET=change-me-to-a-32-byte-random-hex-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Fernet key for encrypting stored Google OAuth tokens.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Google OAuth: owned by the SaaS operator, used ONLY to connect customer
# Drive/Sheets. It is NOT the application login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

TRIAL_DAYS=14
